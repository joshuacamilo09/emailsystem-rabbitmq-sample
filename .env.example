# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# SMTP (for Gmail, use an App Password, never your account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@example.com

# Queues
QUEUE_EMAILS=emails
QUEUE_EMAILS_DLQ=emails_failed

# API
PORT=3000
NODE_ENV=development

# Sentry (optional)
SENTRY_DSN=
